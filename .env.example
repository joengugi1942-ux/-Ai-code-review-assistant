# Application Settings
APP_NAME="AI Code Review Assistant"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (MySQL)
DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/ai_code_review

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Groq LLM
GROQ_API_KEY=your-groq-api-key-here

# GitHub (optional — required for PR review endpoints)
GITHUB_TOKEN=your-github-token-here

# API Authentication
API_KEY=your-api-key-here

# Admin Authentication (for /admin/keys endpoints)
ADMIN_API_KEY=your-admin-api-key-here

# JWT Authentication
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=info
